let wages = dataset(wages)
let m = wages.glm(union ~ educ + exper + female, family: binomial)
wages.add(response = m.residuals(), pearson = m.residuals(type: pearson), deviance = m.residuals(type: deviance), working = m.residuals(type: working), fitted = m.fitted()).summary([response, pearson, deviance, working, fitted])
