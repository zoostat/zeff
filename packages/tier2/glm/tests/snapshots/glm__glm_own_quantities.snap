let m = dataset(wages).glm(union ~ educ + exper + female, family: binomial, link: probit)
let new = frame(educ = [12, 16], exper = [5, 20], female = [0, 1])
new.add(p = m.predict(newdata: new), score = m.predict(newdata: new, type: link))
