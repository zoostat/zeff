=== let wages = dataset(wages)
let g = wages.glm(union ~ educ + exper + exper^2 + female + industry, family: binomial)
let c = g.confusion()
c
c.estimates()
c.statistic("sensitivity")
c.statistic("positive predictive value")
c.statistic()
c.n_obs()
type_of(c)
g.confusion(cutoff: 0.3)
c.export("output/confusion.tex") ===
