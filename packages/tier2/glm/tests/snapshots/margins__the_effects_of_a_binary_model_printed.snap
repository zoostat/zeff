=== let wages = dataset(wages)
let g = wages.glm(union ~ educ + exper + exper^2 + female, family: binomial)
g.margins([educ, exper, female])
let e = g.margins([exper, female])
e.estimates()
e.ci()
e.p_values(female)
e.statistic(exper)
e.df(exper)
let p = wages.glm(union ~ educ * female + exper + log(hours), family: binomial, link: probit, se: robust, level: 0.9)
p.margins([educ, female, hours]) ===
