let d = frame(y = [0, 0, 0, 1, 1, 1, 0, 1], a = [1.0, 2, 3, 4, 5, 6, 3.5, 3.2], s = [1, 2, 3, 4, 5, 6, 7, 8], tiny = [1e-170, 2e-170, 3e-170, 1e-170, 5e-170, 2e-170, 1e-170, 4e-170], big = [1e160, 2e160, 3e160, 1e160, 5e160, 2e160, 1e160, 4e160]).add(twice = 2 * a)
let fresh = frame(y = [0, 1, 1, 0, 1], a = [2.0, NA, 5, 3.4, 4.1], s = [3, 1, 4, NA, 5]).add(twice = 2 * a)
let m = d.glm(y ~ a + s + twice, family: binomial)
m.confusion()
m.confusion(newdata: fresh)
m.curve(type: roc, newdata: fresh)
m.confusion(newdata: fresh.where(y == 1))
m.curve(type: roc, newdata: fresh.where(y == 1))
