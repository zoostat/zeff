## the estimates as a frame
let staff = dataset(staff)
let ols = staff.reg(productivity ~ age + training, fe: site)
let iv = staff.ivreg(productivity ~ age + training, fe: site, instruments: training ~ offer + distance, se: robust)
let plain = staff.ivreg(productivity ~ age + training, instruments: training ~ offer, weights: tenure, weight_type: analytic)
iv.estimates()

