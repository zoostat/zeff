## predict on new rows
let staff = dataset(staff)
let ols = staff.reg(productivity ~ age + training, fe: site)
let iv = staff.ivreg(productivity ~ age + training, fe: site, instruments: training ~ offer + distance, se: robust)
let plain = staff.ivreg(productivity ~ age + training, instruments: training ~ offer, weights: tenure, weight_type: analytic)
iv.predict(staff.head(3))

---
Column<Float> · 3 values
59.3387
53.197
56.8741

## predict on the fitted frame is fitted, and the outcome less it the residuals
let staff = dataset(staff)
let ols = staff.reg(productivity ~ age + training, fe: site)
let iv = staff.ivreg(productivity ~ age + training, fe: site, instruments: training ~ offer + distance, se: robust)
let plain = staff.ivreg(productivity ~ age + training, instruments: training ~ offer, weights: tenure, weight_type: analytic)
let d = staff.add(p = iv.predict(staff), f = iv.fitted(), e = iv.residuals())
d.add(gap = abs(p - f), left = abs(productivity - f - e)).aggregate(largest_gap = max(gap), largest_left = max(left))

---
frame · 1 row × 2 variables

      largest_gap   largest_left
  1   5.68434e-14    3.55271e-15

