## a report beside least squares
let staff = dataset(staff)
let ols = staff.reg(productivity ~ age + training, fe: site)
let iv = staff.ivreg(productivity ~ age + training, fe: site, instruments: training ~ offer + distance, se: robust)
let plain = staff.ivreg(productivity ~ age + training, instruments: training ~ offer, weights: tenure, weight_type: analytic)
report([ols, iv])

---
                           (1)               (2)
  age                   0.004             0.000
                       (0.009)           (0.009)
  training              5.934***          4.582***
                       (0.208)           (0.423)
  ────────────────────────────────────────────────
  Fixed effects             site              site
  Instruments                      offer, distance
  SEs                  classical            robust
  N                        2,400             2,400
  R²              0.256 (within)

* p < 0.05, ** p < 0.01, *** p < 0.001

## a report with every statistic
let staff = dataset(staff)
let ols = staff.reg(productivity ~ age + training, fe: site)
let iv = staff.ivreg(productivity ~ age + training, fe: site, instruments: training ~ offer + distance, se: robust)
let plain = staff.ivreg(productivity ~ age + training, instruments: training ~ offer, weights: tenure, weight_type: analytic)
report([ols, iv, plain], stats: [n_obs, r_squared, r_squared_within, aic, bic])

---
                      (1)               (2)         (3)
  age              0.004             0.000      -0.008
                  (0.009)           (0.009)     (0.011)
  training         5.934***          4.582***    4.327***
                  (0.208)           (0.423)     (0.506)
  (intercept)                                   51.674***
                                                (0.586)
  ───────────────────────────────────────────────────────
  Fixed effects        site              site        none
  Instruments                 offer, distance       offer
  SEs             classical            robust   classical
  N                   2,400             2,400       2,400
  R²                  0.407
  R² within           0.256
  AIC               14561.9
  BIC               14648.7

* p < 0.05, ** p < 0.01, *** p < 0.001

## the table and the fit exported, which print nothing
let staff = dataset(staff)
let ols = staff.reg(productivity ~ age + training, fe: site)
let iv = staff.ivreg(productivity ~ age + training, fe: site, instruments: training ~ offer + distance, se: robust)
let plain = staff.ivreg(productivity ~ age + training, instruments: training ~ offer, weights: tenure, weight_type: analytic)
report([ols, iv]).export("output/table_iv.tex")
iv.export("output/iv.docx")

