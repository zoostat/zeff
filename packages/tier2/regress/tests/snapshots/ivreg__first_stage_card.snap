## both proximity indicators, classical errors: fixest's Sargan 2.65 and Wu–Hausman 3.87
let card = import("data/card.csv")
card.ivreg(lwage ~ exper + expersq + black + south + smsa + educ, instruments: educ ~ nearc4 + nearc2).first_stage()

