> let f = y ~ interact([a, b, c], order: 2) + d
f
f + interact([category(e), g], order: 2)
let a = 1
let b = 2
interact([a, b], order: 2)
y ~ interact([a, b, c], order: 2) + d
y ~ interact([a, b, c], order: 2) + d + interact([category(e), g], order: 2)
error[Z0401]: `interact` is a term of a formula and has no value outside one
 --> scripts/main.zeff:6:1
  |
6 | interact([a, b], order: 2)
  | ^^^^^^^^ called outside a formula
  |
  = help: write it on the right of `~`: `y ~ interact([a, b, c], order: 2)`
[exit 1]

