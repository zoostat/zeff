instrumented: training, training:age · instruments: offer, offer:age
Cragg–Donald F 316.97

## a weak instrument, classical errors
let staff = dataset(staff).add(one = 1.0, twice = distance * 2, by_site = site * 10.0)
staff.where(employee <= 300).ivreg(productivity ~ training, instruments: training ~ distance)

---
ivreg · productivity ~ training
N = 300
standard errors: classical

  term          estimate   std.error   t value   p value   95% CI
  (intercept)    75.4834     52.7490      1.43     0.153   [-28.3243, 179.2912]
  training      -42.9098    101.4015     -0.42     0.672   [-242.4635, 156.6439]

instrumented: training · instruments: distance
Cragg–Donald F 0.25
warning[W1007]: weak instruments: the Cragg–Donald F is 0.25, under 10 (line 2)
  = help: with weak instruments the estimate leans towards the least-squares one and its confidence interval is too narrow; `ar_test()` gives a test and a confidence set that hold however weak the instruments are

## a regressor collinear with another, dropped as `reg` drops it
let staff = dataset(staff).add(one = 1.0, twice = distance * 2, by_site = site * 10.0)
staff.ivreg(productivity ~ distance + twice + training, instruments: training ~ offer)

---
ivreg · productivity ~ distance + twice + training
N = 2,400
standard errors: classical

  term           estimate   std.error   t value   p value   95% CI
  (intercept)     50.8760      0.3897    130.54    <0.001   [50.1118, 51.6403]
  distance         0.0148      0.0205      0.72     0.470   [-0.0254, 0.0551]
  twice         (omitted)
  training         4.3135      0.4967      8.68    <0.001   [3.3394, 5.2876]

instrumented: training · instruments: offer
Cragg–Donald F 748.46
note: `twice` is collinear with the columns before it and was dropped (line 2)

## the instrumented regressor a combination of the others: nothing left to instrument
let staff = dataset(staff).add(one = 1.0, twice = distance * 2, by_site = site * 10.0)
staff.add(both = age + distance).ivreg(productivity ~ age + distance + both, instruments: both ~ offer)

