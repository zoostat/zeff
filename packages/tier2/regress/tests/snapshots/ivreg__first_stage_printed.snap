## an instrument dropped as constant is not in the table
let staff = dataset(staff).add(one = 1.0)
staff.ivreg(productivity ~ training, instruments: training ~ one + offer + distance).first_stage()

---
first stage · training ~ offer + distance

  term          estimate   std.error   t value   p value   95% CI
  (intercept)     0.3318      0.0216     15.33    <0.001   [0.2893, 0.3742]
  offer           0.4867      0.0178     27.36    <0.001   [0.4518, 0.5216]
