weak instruments: Cragg–Donald F 387.89
over-identification: Sargan's statistic, chi2(1) = 0.53   p = 0.467
endogeneity: Durbin–Wu–Hausman F(1, 2,396) = 7.65   p = 0.006

## clustered errors
let staff = dataset(staff)
staff.ivreg(productivity ~ age + training, instruments: training ~ offer + distance, cluster: site).first_stage()

---
first stage · training ~ age + offer + distance

  term          estimate   std.error   t value   p value   95% CI
  (intercept)     0.4835      0.0318     15.20    <0.001   [0.4135, 0.5535]
