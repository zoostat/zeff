instrumented: training · instruments: offer
Cragg–Donald F 2635.27

## two instrumented regressors, the first stage of each above
let staff = dataset(staff)
staff.ivreg(productivity ~ training + tenure, instruments: training + tenure ~ offer + distance + age, first: true)

