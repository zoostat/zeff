let p = frame(u = [1, 1], t = [1, 2], x = [1, 2]).panel(unit: u, time: t)
lag(p["x"])
---
error[Z0602]: `lag` follows a panel's time order and stands inside `add` or `update`
 --> scripts/main.zeff:2:1
  |
2 | lag(p["x"])
  | ^^^ no frame here
  |
  = help: write it inside a definition of a declared panel, as in `wages.add(prev = lag(wage))`

let p = frame(u = [1, 1], t = [1, 2], x = [1, 2]).panel(unit: u, time: t)
p.add(y = lag(x, n: 0))
---
error[Z0401]: `n:` of `lag` is a count of periods of at least 1, but this is 0
 --> scripts/main.zeff:2:21
  |
2 | p.add(y = lag(x, n: 0))
  |                     ^ not a count of periods
  |
  = help: `lag(x)` looks one period back; `lag(x, n: 2)` two

