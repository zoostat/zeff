let w = dataset(wages)
for wage in [1, 2] {
    w.plot(x: educ, y: wage * 2)
}
error[Z0106]: `wage` is both a loop variable or parameter and a variable of w
 --> scripts/main.zeff:3:24
  |
3 |     w.plot(x: educ, y: wage * 2)
  |                        ^^^^ which one is meant?
  |
  = help: rename the loop variable, or the column with `rename`; inside a frame method a loop variable wins over a column, so a clash is never resolved silently

let w = dataset(wages)
