=== let wages = dataset(wages)
let m = wages.reg(log(wage) ~ educ + exper + exper^2 + female + industry, se: robust)
let a = m.margins([educ, exper, female])
report([m, a])
let c = wages.reg(log(wage) ~ educ * female + exper, cluster: worker)
report([a, c.margins([educ, female, exper])], title: "Average effects on log wages", digits: 4, labels: {exper: "Experience", female: "Female"})
report([m.margins([exper, female], at: {industry: "Mining", exper: [5, 20]})], stars: false)
report([m.margins()], stats: [n_obs, r_squared, aic])
let t = wages.add(twice = educ * 2).reg(log(wage) ~ educ + twice + female)
report([t, t.margins([educ, twice, female])]) ===
