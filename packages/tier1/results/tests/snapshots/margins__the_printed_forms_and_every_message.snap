=== let wages = dataset(wages)
let m = wages.reg(log(wage) ~ educ + exper + exper^2 + female + industry, se: robust)
m.margins([educ, exper, female, industry])
m.margins(exper)
let e = m.margins([exper, industry])
e.estimates()
e.ci()
e.p_values("industry=Mining")
e.p_values(exper)
e.n_obs()
type_of(e) ===
