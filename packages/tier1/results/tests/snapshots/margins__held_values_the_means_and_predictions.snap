=== let wages = dataset(wages)
let h = wages.reg(log(wage) ~ log(hours) + educ)
h.margins(hours)
h.margins(hours, type: mem)
h.margins(hours, at: {hours: 40})
wages.reg(log(wage) ~ educ + hours + max(hours - 40, 0)).margins(hours, type: mem)
wages.reg(log(wage) ~ educ * female + exper + exper^2, weights: hours).margins([educ, exper], type: mem)
wages.reg(log(wage) ~ exper + exper^2 + female + female:exper, weights: educ, weight_type: frequency).margins(at: {female: 0})
let w = wages.add(long = hours > 40)
w.reg(log(wage) ~ educ * long).margins(educ, at: {long: true})
w.reg(log(wage) ~ educ * long).margins(educ, type: mem)
wages.reg(log(wage) ~ category(educ) * female).margins(female, at: {educ: 12}) ===
