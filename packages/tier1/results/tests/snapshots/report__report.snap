> let wages = dataset(wages)
let m1 = wages.reg(log(wage) ~ educ + exper + female)
let m2 = wages.reg(log(wage) ~ educ + exper + exper^2 + female, se: robust)
let m3 = wages.reg(log(wage) ~ educ + exper + female, cluster: worker)
report([m1, m2, m3])
report([m1, m2], stats: [n_obs, r_squared, aic, bic], digits: 4, title: "Wage regressions")
report([m1, m2], stars: false, labels: {educ: "Years of schooling", exper: "Experience"})
report([m1], stats: [], digits: 0)
type_of(report([m1]))
report([m1, m2]).export("output/table1.docx")
report([m1, m2]).export("output/table1.tex")
m1.export("output/m1.docx")
m1.test(educ == exper).export("output/test.tex")
m2.compare(m1).export("output/compare.tex")
