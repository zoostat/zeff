---
source: crates/zeff-engine/tests/misleading_messages.rs
expression: "all(&[&format!(\"{data}{clean}c.add(floor = case {{ floor_txt == \\\"Ground\\\" => 0, floor_txt == \\\"Upper\\\" => 99, floor_txt == \\\"Lower\\\" => -1, _ => to(floor_txt, Int) }})\\n\"),\n&format!(\"{data}d.add(floor = case {{ floor_txt == \\\"Ground\\\" => 0, floor_txt == \\\"Upper\\\" => 99, floor_txt == \\\"Lower\\\" => -1, _ => to(floor_txt, Int) }})\\n\"),\n&format!(\"{data}d.add(r = case {{ y > 0 => x / y, _ => 0 }})\\n\"),\n&format!(\"{data}d.add(r = case {{ y >= 0 => x / y, _ => 0 }})\\n\"),\n&format!(\"{data}d.add(r = x / y)\\n\"),\n&format!(\"{data}d.add(r = case {{ y > 0 => x - mean(x), _ => 0 }})\\n\"),\n&format!(\"{data}d.where(case {{ floor_txt == \\\"Ground\\\" => true, floor_txt == \\\"Upper\\\" => false, floor_txt == \\\"Lower\\\" => false, _ => to(floor_txt, Int) > 5 }})\\n\"),\n&format!(\"{data}d.add(by: g, f = case {{ floor_txt == \\\"Ground\\\" => 0, _ => to(floor_txt, Int) }})\\n\"),\n&format!(\"{data}d.add(m = case {{ floor_txt == \\\"Ground\\\" => 0, _ => case {{ y > 0 => x / y, _ => to(floor_txt, Float) }} }})\\n\"),])"
---
let d = frame(floor_txt = ["Ground", "3", "Upper", "x7", "Lower", "12", "none"], g = ["a", "a", "a", "b", "b", "b", "b"], x = [1.0, 0.0, 3.0, 0.0, 5.0, 6.0, 0.0], y = [0.0, 0.0, 1.0, 0.0, 2.0, 1.0, 3.0])
let c = d.where(floor_txt != "x7" && floor_txt != "none")
c.add(floor = case { floor_txt == "Ground" => 0, floor_txt == "Upper" => 99, floor_txt == "Lower" => -1, _ => to(floor_txt, Int) })
---- exit code 0
frame · 5 rows × 5 variables

      floor_txt   g   x   y   floor
  1   Ground      a   1   0       0
  2   3           a   0   0       3
  3   Upper       a   3   1      99
  4   Lower       b   5   2      -1
  5   12          b   6   1      12

