==== one.typ
// a Zeff export: place it in a document with `#include`
// t_test · one-sample · x
#table(
  columns: 1,
  align: left,
  stroke: none,
  table.hline(stroke: 0.8pt),
  "  H0: the population mean of x equals 0            μ = 0",
  "  H1: the population mean of x differs from 0      μ ≠ 0",
  "",
  "N = 6   mean = 3.667   sd = 2.160",
  "difference (mean − 0) = 3.667   95% CI [1.400, 5.934]",
  "t = 4.16   df = 5   p = 0.009",
  "decision at α = 0.05: reject H0 (p = 0.009)",
  table.hline(stroke: 0.8pt),
)
==== two.typ
// a Zeff export: place it in a document with `#include`
// t_test · Welch two-sample · x by g
#table(
  columns: 4,
  align: (left, right, right, right,),
  stroke: none,
  table.hline(stroke: 0.8pt),
  table.header("group", "N", "mean", "sd"),
  table.hline(stroke: 0.5pt),
  "a", "3", "2.000", "1.000",
  "b", "3", "5.333", "1.528",
  table.hline(stroke: 0.8pt),
  table.cell(colspan: 4, align: left, text(size: 0.85em, "  H0: the population means of x are equal in a and b        μ(a) − μ(b) = 0")),
  table.cell(colspan: 4, align: left, text(size: 0.85em, "  H1: the population means of x differ between a and b      μ(a) − μ(b) ≠ 0")),
  table.cell(colspan: 4, align: left, text(size: 0.85em, "difference (a − b) = -3.333   95% CI [-6.454, -0.212]")),
  table.cell(colspan: 4, align: left, text(size: 0.85em, "t = -3.16   df = 3.4   p = 0.042")),
  table.cell(colspan: 4, align: left, text(size: 0.85em, "Hedges' g = -2.07   95% CI [-3.80, -0.33]")),
  table.cell(colspan: 4, align: left, text(size: 0.85em, "decision at α = 0.05: reject H0 (p = 0.042)")),
)
