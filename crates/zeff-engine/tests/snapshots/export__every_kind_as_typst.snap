==== report.typ
// a Zeff export: place it in a document with `#include`
#table(
  columns: 3,
  align: (left, right, right,),
  stroke: none,
  table.hline(stroke: 0.8pt),
  table.header("", "(1)  ", "(2)  "),
  table.hline(stroke: 0.5pt),
  "(intercept)", "1.832***", "1.900***",
  "", "(0.022)  ", "(0.022)  ",
  "educ", "0.076***", "0.076***",
  "", "(0.001)  ", "(0.001)  ",
  "exper", "0.022***", "0.022***",
  "", "(0.000)  ", "(0.000)  ",
  "female", "", "-0.133***",
  "", "", "(0.006)  ",
  table.hline(stroke: 0.5pt),
  "SEs", "classical", "hc3",
  "N", "18,179", "18,179",
  "R²", "0.184", "0.203",
  table.hline(stroke: 0.8pt),
  table.cell(colspan: 3, align: left, text(size: 0.85em, "* p < 0.05, ** p < 0.01, *** p < 0.001")),
)
==== fit.typ
// a Zeff export: place it in a document with `#include`
// reg · log(wage) ~ educ + exper
#table(
  columns: 6,
  align: (left, right, right, right, right, left,),
  stroke: none,
  table.hline(stroke: 0.8pt),
  table.header("term", "estimate", "std.error", "t value", "p value", "95% CI"),
  table.hline(stroke: 0.5pt),
  "(intercept)", "1.8316", "0.0221", "82.93", "<0.001", "[1.7883, 1.8749]",
  "educ", "0.0760", "0.0014", "55.05", "<0.001", "[0.0733, 0.0787]",
  "exper", "0.0223", "0.0005", "48.77", "<0.001", "[0.0214, 0.0232]",
  table.hline(stroke: 0.8pt),
  table.cell(colspan: 6, align: left, text(size: 0.85em, "N = 18,179 (233 rows dropped for NA in model variables)")),
  table.cell(colspan: 6, align: left, text(size: 0.85em, "standard errors: classical")),
  table.cell(colspan: 6, align: left, text(size: 0.85em, "R² 0.184 · adjusted R² 0.184")),
)
