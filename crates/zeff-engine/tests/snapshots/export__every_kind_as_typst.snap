==== describe.TYP
// a Zeff export: place it in a document with `#include`
// d · 6 rows × 4 variables
#table(
  columns: 5,
  align: (left, left, right, right, left,),
  stroke: none,
  table.hline(stroke: 0.8pt),
  table.header("variable", "type", "non-missing", "missing", "example"),
  table.hline(stroke: 0.5pt),
  "x", "Float", "6", "0", "1",
  "z", "Float", "6", "0", "0.5",
  "g", "Str", "6", "0", "a",
  "odd \\ \"name\" #1 $x_1$", "Int", "6", "0", "1",
  table.hline(stroke: 0.8pt),
)
