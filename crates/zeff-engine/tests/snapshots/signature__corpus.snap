> let d = import("data/sm|
import([[path]], delim: Str, header: Bool = true, skip: Int = 0, na_values: List, types: Record, names: keep | snake = keep, quote: Str, decimal: Str, thousands: Str, encoding: Str = "utf-8")
    path: The file, written with `/` from the project folder, or `root:file` for a data root. A path outside the project is refused (Z0701), and one that differs only in case from the file's real name is refused with the real spelling (Z0702).
    (Read a data file into a frame)
