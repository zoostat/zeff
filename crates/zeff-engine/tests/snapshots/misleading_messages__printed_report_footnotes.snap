source: crates/zeff-engine/tests/misleading_messages.rs
expression: "[format!(\"{data}report([d.reg(y ~ x), d.reg(y ~ x + z), d.reg(y ~ z)])\\n\"),\nformat!(\"{data}let m1 = d.reg(y ~ x)\\nlet m2 = d.reg(y ~ x + z)\\nreport([m1, m2])\\n\"),\nformat!(\"{data}report([d.reg(y ~ x), d.reg(w ~ z), d.reg(y ~ z)])\\n\"),\nformat!(\"{data}report([d.reg(y ~ x), d.reg(y ~ x + z), d.reg(y ~ z), d.reg(w ~ z)])\\n\"),].iter().map(|script|\nprinted(script)).collect::<Vec<_>>().join(\"\\n====\\n\")"
