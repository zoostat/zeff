---
source: crates/zeff-cli/tests/cli.rs
expression: "text.replace(VERSION, \"(the version of the engine)\")"
---
# Completions of the zeff command line for fish.
# Written by `zeff completions fish` of Zeff (the version of the engine): write it again after an upgrade.
# Load it with:  zeff completions fish | source   or save it as ~/.config/fish/completions/zeff.fish

# The command on the line: the first word that is neither an option nor what an option takes.
function __zeff_command
    set -l tokens (commandline -opc)
    set -e tokens[1]
    set -l skip 0
    for token in $tokens
        if test $skip -eq 1
            set skip 0
            continue
        end
        switch $token
            case -p --project --format --color --width --memory
                set skip 1
            case '-*'
            case '*'
                echo $token
                return 0
        end
    end
    return 1
end

function __zeff_no_command
    not __zeff_command >/dev/null
end

function __zeff_after
    set -l command (__zeff_command)
    or return 1
    contains -- $command $argv
end

# No file names unless a command takes a script.
complete -c zeff -f

complete -c zeff -n __zeff_no_command -a new -d 'create a project folder'
complete -c zeff -n __zeff_no_command -a run -d 'run scripts/main.zeff, or the script named'
complete -c zeff -n __zeff_no_command -a check -d 'check a script without running it'
complete -c zeff -n __zeff_no_command -a test -d 'run the tests of the project'
complete -c zeff -n __zeff_no_command -a fmt -d 'write every script in the one style of the language'
complete -c zeff -n __zeff_no_command -a lsp -d 'start the language server an editor talks to'
complete -c zeff -n __zeff_no_command -a repl -d 'open the console'
complete -c zeff -n __zeff_no_command -a eval -d 'run one statement and print its value'
complete -c zeff -n __zeff_no_command -a help -d 'a help page, the functions of a package, or a code explained'
complete -c zeff -n __zeff_no_command -a version -d 'print the version of Zeff'
complete -c zeff -n __zeff_no_command -a selftest -d 'check this installation against the published results'
complete -c zeff -n __zeff_no_command -a completions -d 'write the completions of a shell'

complete -c zeff -l project -s p -x -a '(__fish_complete_directories)' -d 'the project to act on'
complete -c zeff -l format -x -a 'text json' -d 'text, or JSON records for an editor'
complete -c zeff -l color -x -a 'auto always never' -d 'colour in messages'
complete -c zeff -l ascii -d 'rules and symbols in ASCII'
complete -c zeff -l width -x -d 'the width frames and tables wrap at'
complete -c zeff -l memory -x -d 'the memory budget of the run, as in 2GB'
complete -c zeff -l deny-warnings -d 'a warning that no pragma allows is an error'
complete -c zeff -l check -d 'for fmt: write nothing, say which scripts would change'
complete -c zeff -l stdio -d 'for lsp: talk on standard input and output'
complete -c zeff -l quiet -s q -d 'hide notes'
complete -c zeff -l verbose -s v -d 'show timings and build details'

complete -c zeff -n '__zeff_after help' -a 'E PI abs acos add add_days add_months aggregate all alternative annotate anova any append area asin assert atan atan2 attempt bar bars base beta between bin boxplot category cdf ceil center chi2_test choose ci clamp coalesce coef coef_plot compare contains coord correlation cos covariance dataset datasets date datetime day days_between density derive describe design df diff dist.beta dist.binomial dist.chi2 dist.exponential dist.f dist.gamma dist.lognormal dist.mixture dist.negbinomial dist.normal dist.poisson dist.t dist.truncated dist.tukey dist.uniform distinct div draw drop drop_missing duplicates effect_size ends_with equal error errorbars estimates event exp expm1 export extract facet factorial fill_forward fill_missing filter first fisher_test fit_measures fitted floor format frame gamma h0 h1 head heatmap histogram hline import influence interact inv_logit iqr is is_finite is_in is_missing iterate join keys kruskal_test ks_test kurtosis label labels lag last lead legend len levels line lines log log10 log1p log2 log_gamma logit lower mad map max mean median merge min mod month months_between n n_cols n_distinct n_missing n_obs n_rows name_of note now p_adjust p_values pad panel pdf plot points posthoc predict print proportion_test qq_plot quantile quantile_group quarter r_squared rank recode reduce reg rename replace report residuals reversed ribbon round row_mean row_sum rug running_product running_sum sample save scale scale_x scale_y scatter sd seed select seq shapiro_test sign sin skewness slice sort sorted split sqrt standardize starts_with statistic std_errors step sum summary t_test table tabulate tail tan test text theme tile to to_long to_wide today trim truncate type_of unique update upper variables variance vars vcov vif vline warn week weekday where wilcoxon_test winsorize year core time data dist results stats regress Z0001 W0101 W0102 W0201 W0202 W0203 W0204 W0205 W0206 W0207 W0208 W0209 W0210 W0211 W0212 W0301 W0302 W0303 W0801 W0805 W0503 W1001 W1002 W1003 Z0507 W1004 W1006 W0601 W0602 W0701 W0702 W0703 Z0101 Z0102 Z0103 Z0105 Z0106 Z0107 Z0108 Z0109 Z0110 Z0111 Z0203 Z0204 Z0205 Z0206 Z0207 Z0208 Z0209 Z0210 Z0211 Z0212 Z0213 Z0214 Z0215 Z0216 Z0217 Z0218 Z0219 Z0220 Z0221 Z0222 Z0223 Z0224 Z0225 Z0301 Z0302 Z0303 Z0304 Z0305 Z0306 Z0307 Z0308 Z0309 Z0310 Z0311 Z0312 Z0313 Z0314 Z0315 Z0316 Z0317 Z0318 Z0319 Z0320 Z0321 Z0322 Z0323 Z0401 Z0402 Z0403 Z0404 Z0405 Z0406 Z0407 Z0408 Z0409 Z0410 Z0411 Z0412 Z0413 Z0414 Z0415 Z0416 Z0417 Z0418 Z0419 Z0420 Z0421 Z0422 Z0601 Z0602 Z0603 Z0604 Z0609 Z0610 Z0611 Z0605 Z0606 Z0607 Z0608 Z0701 Z0702 Z0704 Z0705 Z0706 Z0707 Z0709 Z0710 Z0712 Z0713 Z0714 Z0715 Z0716 Z0801 Z0803 Z0802 Z9001'
complete -c zeff -n '__zeff_after completions' -a 'bash zsh fish powershell'
complete -c zeff -n '__zeff_after run check repl' -k -a '(__fish_complete_suffix .zeff)'
