---
source: crates/zeff-cli/tests/cli.rs
expression: "text.replace(VERSION, \"(the version of the engine)\")"
---
#compdef zeff
# Completions of the zeff command line for zsh.
# Written by `zeff completions zsh` of Zeff (the version of the engine): write it again after an upgrade.
# Load it with:  source <(zeff completions zsh)   (after compinit), or save it as _zeff in a folder of $fpath.

_zeff() {
    local -a commands options shells topics codes
    commands=(
        'new:create a project folder'
        'run:run scripts/main.zeff, or the script named'
        'check:check a script without running it'
        'test:run the tests of the project'
        'fmt:write every script in the one style of the language'
        'lsp:start the language server an editor talks to'
        'repl:open the console'
        'eval:run one statement and print its value'
        'help:a help page, the functions of a package, or a code explained'
        'explain:explain the code of an error or a warning'
        'report-bug:build a report of a failure for you to read'
        'engine:list, install, remove or choose the engines installed'
        'doctor:report on this installation and what to do about each problem'
        'version:print the version of Zeff'
        'audit:read the recorded runs against the known wrong results'
        'selftest:check this installation against the published results'
        'completions:write the completions of a shell'
    )
    options=(
        '--project:the project to act on'
        '-p:the project to act on'
        '--format:text, or JSON records for an editor'
        '--color:colour in messages'
        '--ascii:rules and symbols in ASCII'
        '--width:the width frames and tables wrap at'
        '--memory:the memory budget of the run, as in 2GB'
        '--frozen:nothing is downloaded: no engine is fetched'
        '--offline:no request is made: no engine is fetched'
        '--install:install the engine the project pins without asking'
        '-y:install the engine the project pins without asking'
        '--yes:the same as --install'
        '--deny-warnings:a warning that no pragma allows is an error'
        '--check:for fmt: write nothing, say which scripts would change'
        '--stdio:for lsp: talk on standard input and output'
        '--include-data:for report-bug: write the data files beside the report'
        '--synthetic:for report-bug: write the data files with made-up values'
        '--line:for report-bug: a line of the statement whose result is wrong'
        '--reference:for report-bug: a file holding the result it should give'
        '--quiet:hide notes'
        '-q:hide notes'
        '--verbose:show timings and build details'
        '-v:show timings and build details'
    )
    shells=(bash zsh fish powershell)
    topics=(E PI abs acos add add_time adjustment_sets aggregate all alternative annotate anova any append ar_test area asin assert atan atan2 attempt bar bars base beta between bin boxplot category cdf ceil center check chi2_test choose ci clamp coalesce coef coef_plot compare confusion contains coord correlation cos covariance curve dag dataset datasets date datetime day density derive describe design df diff dist.beta dist.binomial dist.chi2 dist.exponential dist.f dist.gamma dist.hypergeometric dist.logistic dist.lognormal dist.mixture dist.negbinomial dist.normal dist.poisson dist.t dist.truncated dist.tukey dist.uniform dist.weibull distinct div draw drop drop_missing duplicates effect_size ends_with equal error errorbars estimates event exclusion_check exp expm1 export extract facet factorial fill_missing filter first first_stage fisher_test fit_measures fitted floor format frame gamma glm h0 h1 head heatmap histogram hline hour implied_independencies import influence instruments interact inv_logit iqr is is_finite is_in is_missing iterate ivreg join keys kruskal_test ks_test kurtosis label labels lag last lead legend len levels line lines log log10 log1p log2 log_gamma logit lower mad map margins max mcnemar_test mean median merge min minute mod month n n_chars n_cols n_distinct n_missing n_obs n_rows name_of note now p_adjust p_values pad panel pdf plot points posthoc predict print proportion_test qq_plot quantile quarter r_squared rank recode reduce reg reliability rename replace report residuals reversed ribbon round row row_number rug running sample save scale scale_x scale_y scatter sd second seed select seq shapiro_test sign sin skewness slice sort sorted split sqrt standardize start_of starts_with statistic std_errors step sum summary t_test table tabulate tail tan test text theme tile time_between timer to to_long to_wide today trim truncate type_of unique update upper variables variance variance_test vars vcov vif vline warn week weekday where wilcoxon_test winsorize year core time data dist results stats publish regress measure identify Z0001 W0101 W0102 W0201 W0202 W0203 W0204 W0205 W0206 W0207 W0208 W0209 W0210 W0211 W0212 W0213 W0301 W0302 W0303 W0801 W0805 W0401 W0503 W0510 W0511 W0512 W1001 W1002 W1003 Z0504 Z0505 Z0507 Z0508 W1004 W1006 W1007 W1008 W0601 W0602 W0701 W0702 W0703 Z0101 Z0102 Z0103 Z0105 Z0106 Z0107 Z0108 Z0109 Z0110 Z0111 Z0203 Z0204 Z0205 Z0206 Z0207 Z0208 Z0209 Z0210 Z0211 Z0212 Z0213 Z0214 Z0215 Z0216 Z0217 Z0218 Z0219 Z0220 Z0221 Z0222 Z0223 Z0224 Z0225 Z0226 Z0301 Z0302 Z0303 Z0304 Z0305 Z0306 Z0307 Z0308 Z0309 Z0310 Z0311 Z0312 Z0313 Z0314 Z0315 Z0316 Z0317 Z0318 Z0319 Z0320 Z0321 Z0322 Z0323 Z0401 Z0402 Z0403 Z0404 Z0405 Z0406 Z0407 Z0408 Z0409 Z0410 Z0411 Z0412 Z0413 Z0414 Z0415 Z0416 Z0417 Z0418 Z0419 Z0420 Z0421 Z0422 Z0601 Z0602 Z0603 Z0604 Z0609 Z0610 Z0611 Z0605 Z0606 Z0607 Z0608 Z0701 Z0702 Z0704 Z0705 Z0706 Z0707 Z0708 Z0709 Z0710 Z0711 Z0712 Z0713 Z0714 Z0715 Z0716 Z0717 Z0801 Z0803 Z0804 Z0802 Z9001)
    codes=(W0101 W0102 W0201 W0202 W0203 W0204 W0205 W0206 W0207 W0208 W0209 W0210 W0211 W0212 W0213 W0301 W0302 W0303 W0401 W0503 W0510 W0511 W0512 W0601 W0602 W0701 W0702 W0703 W0801 W0805 W1001 W1002 W1003 W1004 W1006 W1007 W1008 Z0001 Z0101 Z0102 Z0103 Z0105 Z0106 Z0107 Z0108 Z0109 Z0110 Z0111 Z0203 Z0204 Z0205 Z0206 Z0207 Z0208 Z0209 Z0210 Z0211 Z0212 Z0213 Z0214 Z0215 Z0216 Z0217 Z0218 Z0219 Z0220 Z0221 Z0222 Z0223 Z0224 Z0225 Z0226 Z0301 Z0302 Z0303 Z0304 Z0305 Z0306 Z0307 Z0308 Z0309 Z0310 Z0311 Z0312 Z0313 Z0314 Z0315 Z0316 Z0317 Z0318 Z0319 Z0320 Z0321 Z0322 Z0323 Z0401 Z0402 Z0403 Z0404 Z0405 Z0406 Z0407 Z0408 Z0409 Z0410 Z0411 Z0412 Z0413 Z0414 Z0415 Z0416 Z0417 Z0418 Z0419 Z0420 Z0421 Z0422 Z0504 Z0505 Z0507 Z0508 Z0601 Z0602 Z0603 Z0604 Z0605 Z0606 Z0607 Z0608 Z0609 Z0610 Z0611 Z0701 Z0702 Z0704 Z0705 Z0706 Z0707 Z0708 Z0709 Z0710 Z0711 Z0712 Z0713 Z0714 Z0715 Z0716 Z0717 Z0801 Z0802 Z0803 Z0804 Z9001)
    # The command: the first word that is neither an option nor what an option takes.
    local command=""
    local -i i=2
    while (( i < CURRENT )); do
        case "${words[i]}" in
            -p|--project|--format|--color|--width|--memory|--line|--reference) (( i++ )) ;;
            -*) ;;
            *) command="${words[i]}"; break ;;
        esac
        (( i++ ))
    done
    case "${words[CURRENT-1]}" in
        -p|--project) _files -/; return ;;
        --format) compadd text json; return ;;
        --color) compadd auto always never; return ;;
        --width) return ;;
        --memory) return ;;
        --line) return ;;
        --reference) return ;;
    esac
    if [[ "${words[CURRENT]}" == -* ]]; then
        _describe 'option' options
        return
    fi
    case "$command" in
        "") _describe 'command' commands ;;
        help) compadd -a topics ;;
        explain) compadd -a codes ;;
        completions) compadd -a shells ;;
        run|check|repl|report-bug) _files -g '*.zeff' ;;
    esac
}
# Run where zsh loads this file as the function itself; registered where it is sourced.
if [[ "${funcstack[1]}" == "_zeff" ]]; then
    _zeff "$@"
else
    compdef _zeff zeff
fi
