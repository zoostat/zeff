      {
        "activeParameter": 1,
        "documentation": "Linear regression by least squares, with fixed effects",
        "label": "data.reg(formula, fe: Terms, se: classical | robust | hc2 | hc3, cluster: Var, weights: Var, weight_type: frequency | analytic | sampling = sampling, level: Float = 0.95)",
        "parameters": [
          {
            "documentation": "The frame.",
            "label": [
              0,
              4
            ]
          },
          {
            "documentation": "`y ~ terms`, written in the call or bound with `let`.",
            "label": [
              9,
              16
            ]
          },
          {
            "documentation": "The fixed effects to absorb: a variable, `firm`; several joined by `+`, `firm + year`; an interacted effect joined by `:`, `industry:year`. Int, text, category and date variables all serve; `*`, a range, an expression and the intercept are refused, and so is an effect that is also a variable of the formula.",
            "label": [
              18,
              27
            ]
          },
          {
            "documentation": "The kind of standard error: `classical`, `robust` (HC1), `hc2` or `hc3`; `classical` unless sampling weights are given, when `robust`. With `fe:`, `hc2` and `hc3` are refused (Z0410), since an observation's leverage in the full design is not available.",
            "label": [
              29,
              63
            ]
          },
          {
            "documentation": "The variable whose values group the observations for clustered errors (CR1).",
            "label": [
              65,
              77
            ]
          },
          {
            "documentation": "The weight variable.",
            "label": [
              79,
              91
            ]
          },
          {
            "documentation": "What the weights are: `frequency` counts, `analytic` precision weights, `sampling` probability weights.",
            "label": [
              93,
              148
            ]
          },
          {
            "documentation": "The confidence level of the intervals.",
            "label": [
              150,
              169
            ]
          }
        ]
      }
    ]
  }
}
