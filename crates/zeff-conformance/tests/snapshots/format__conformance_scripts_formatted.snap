==== script 87
/// A regression's slope.
fn slope(data: Frame, outcome: Var, on: Var) -> Float {
    data.reg(outcome ~ on).coef(on)
}
/// The coefficient of a named term.
fn of(data: Frame, outcome: Var, on: Var, term: Str) -> Float {
    data.reg(outcome ~ on).coef(term)
}
/// The slope by name_of.
fn slope_named(data: Frame, outcome: Var, on: Var) -> Float {
    data.reg(outcome ~ on).coef(name_of(on))
}
let w = dataset(wages)
w.slope(wage, educ)
let twin = w.add(on = educ * 2, outcome = wage)
twin.slope(wage, educ)
w.of(wage, educ, "educ")
w.of(wage, educ, "(intercept)")
w.slope_named(wage, educ)
let m = w.reg(wage ~ educ)
for v in vars(educ) {
    print(m.coef(v))
}
