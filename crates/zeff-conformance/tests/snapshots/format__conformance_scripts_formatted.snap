==== script 102
// The sample project of release 0.2.0: a data-cleaning script end to end, from a spreadsheet
// export in German format to grouped summaries and a shipped dataset. `zeff run` in this folder
// prints what expected/stdout.txt holds, and its messages are expected/stderr.txt; the script
// tests compare both byte for byte on every target.

// 1. Import. The file has `;` between fields, a decimal comma, a point between groups of digits,
//    Windows-1252 letters, -99 for a missing value, and headers with spaces, which `names: snake`
//    turns into names a script can write.
let raw = import("data/staff_de.csv",
                 decimal: ",",
                 thousands: ".",
                 encoding: "windows-1252",
                 na_values: [-99],
                 names: snake)
raw.describe()
raw.head(5)

// 2. Clean. Keep the rows of working age with a recorded wage, give the variables short names,
//    derive what the analysis needs, and compute each worker's log-wage gap within their region.
let staff = raw
    .where(age >= 18 && age <= 65 && !is_missing(monthly_wage))
    .rename(wage = monthly_wage, hours = weekly_hours, educ = years_of_education)
    .add(lwage = log(wage), hourly = wage / (hours * 4.33), exper = age - educ - 6)
    .update(exper = 0, where: exper < 0)
    .add(wage_gap = lwage - mean(lwage), by: region)
staff.describe()

// 3. Look. The highest wages, the cheapest hours by region, and the statistics by group.
staff.sort(wage, desc: true).select([staff_id, region, wage, hours, educ]).head(5)
staff.sort([region, hourly]).select([region, hourly, hours, wage]).head(5)
staff.summary([wage, hourly, hours, educ], by: female)
staff.mean(wage, by: region)
staff.quantile(hourly, p: [0.1, 0.5, 0.9])
print("workers:",
      staff.n_rows(),
      "regions:",
      n_distinct(staff["region"]),
      "median hourly wage:",
      staff.median(hourly))

// 4. A shipped dataset, loaded with its labels and categories, and the same statistics on it.
let sleep = dataset(sleep)
sleep
sleep.mean(extra, by: group)
dataset(wages).summary([wage, educ], by: union)
==== script 103
// The sample project of release 0.3.0: a simulation and its p-values end to end, with no data
// file. `zeff run` in this folder prints what expected/stdout.txt holds, and its messages are
// expected/stderr.txt; the script tests compare both byte for byte on every target.

// 1. One seed for the whole run, set before any draw, so that the script repeats exactly.
seed(2026)

// 2. Draws from several families into a frame. The scores follow a normal distribution, the
//    waiting times an exponential one, the visits a Poisson one, and the wage index is a mixture
//    of two kinds of worker.
let wage_mix = dist.mixture([dist.lognormal(meanlog: 2.5, sdlog: 0.3),
                             dist.lognormal(meanlog: 3.1, sdlog: 0.4)],
                            probs: [0.6, 0.4])
let sim = frame(score = dist.normal(mean: 100, sd: 15).draw(400),
                wait = dist.exponential(rate: 0.5).draw(400),
                visits = dist.poisson(lambda: 3).draw(400),
                wage = wage_mix.draw(400))
sim.describe()
sim.summary([score, wait, visits, wage])

// 3. Association: the three correlation methods, with p-values for the Pearson one.
sim.correlation([score, wait, visits, wage], p_values: true)
sim.correlation([score, wage], method: spearman)
sim.covariance([score, wait])

// 4. A p-value from a tail. The z statistic of the mean score against 100, one-sided and
//    two-sided, from the upper tail of the normal distribution computed directly.
let z = (sim.mean(score) - 100) / (sim.sd(score) / sqrt(sim.n_rows()))
print("z:", z)
print("one-sided p:", dist.normal().cdf(z, upper: true))
print("two-sided p:", 2 * dist.normal().cdf(abs(z), upper: true))

// 5. A far tail keeps its digits, and the quantile inverts the distribution function.
print("P(Z > 8):", dist.normal().cdf(8, upper: true))
print("t 0.975 quantile, 24 df:", dist.t(df: 24).quantile(0.975))

// 6. A truncated and a mixed distribution: values and draws.
let cut = dist.truncated(dist.normal(mean: 100, sd: 15), lower: 70, upper: 130)
cut
print("P(X <= 100) in the truncated distribution:", cut.cdf(100))
frame(cut = cut.draw(300, seed: 7)).describe()
wage_mix
print("mixture median:", wage_mix.quantile(0.5))
print("mixture P(wage > 40):", wage_mix.cdf(40, upper: true))
==== script 104
// The sample project of release 0.4.0: a regression analysis end to end on the shipped wages,
// from the data root to a publication table. `zeff run` in this folder prints what
// expected/stdout.txt holds, and its messages are expected/stderr.txt; the script tests compare
// both byte for byte on every target, and the conformance report carries the digests of the
// files the last section exports.

// 1. Load and clean. The CSV form of the shipped dataset carries no labels or categories, so the
//    script adds them: the log wage and squared experience the model needs, industry as a
//    category coded by deviations from the mean (a sum contrast), the two smallest industries
//    merged, and the codes of `female` labelled.
let wages = import("zeff:wages.csv")
    .add(lwage = log(wage), exper2 = exper^2, industry = category(industry, contrast: sum))
    .recode(industry, ["Mining" => "Other", "Utilities" => "Other"])
    .label(female, [0 => "male", 1 => "female"])

// 2. Describe.
wages.describe()
wages.summary([lwage, educ, exper, hours], by: female)

// 3. Four regressions of one model: classical, robust and clustered standard errors, and hours
//    as sampling weights.
let f = lwage ~ educ + exper + exper2 + female
let m1 = wages.reg(f)
let m2 = wages.reg(f, se: robust)
let m3 = wages.reg(f, cluster: worker)
let m4 = wages.reg(f, weights: hours)
m3
m3.summary(standardized: true, fit_measures: true)

// 4. The result interface on the clustered fit: the estimates as a frame, one coefficient, its
//    interval at another level, and the fit measures.
m3.estimates().where(p_value < 0.05)
print("return to schooling:", m3.coef(educ))
m3.ci(educ, level: 0.9)
m3.r_squared()
m3.fit_measures()

// 5. Tests, a nested comparison and a derived quantity. The restriction is written in
//    coefficient space; the comparison adds union membership and the industry deviations; the
//    turning point of the experience profile comes with its delta-method standard error.
m3.test(educ == exper)
m3.test(exper == 0, exper2 == 0)
let m5 = wages.reg(lwage ~ educ + exper + exper2 + female + union + industry, cluster: worker)
m5.compare(m3)
m5.derive(peak_exper = -exper / (2 * exper2), return_decade = exp(educ * 10) - 1)

// 6. Influence and prediction: the three most influential rows, and predictions for new
//    workers.
m3.influence().sort(cooks_distance, desc: true).head(3)
m3.predict(newdata: frame(educ = [12, 16, 16],
                          exper = [5, 5, 20],
                          exper2 = [25, 25, 400],
                          female = [0, 1, 1]))

// 7. The publication table, printed and exported to Word and LaTeX, and one model's summary
//    exported on its own.
let table1 = report([m1, m2, m3, m4],
                    stats: [n_obs, r_squared],
                    labels: {educ: "Years of schooling",
                             exper: "Experience",
                             exper2: "Experience squared"},
                    title: "Table 1. Log hourly wage")
table1
table1.export("output/table1.docx")
table1.export("output/table1.tex")
m5.export("output/model5.tex")
==== script 105
// The sample project of release 0.5.0: the language complete, with the project's own functions.
// `zeff run` in this folder prints what expected/stdout.txt holds, and its messages are
// expected/stderr.txt; the script tests compare both byte for byte on every target.

// 1. The project's functions. `use` brings a module of `functions/` into the script; the two
//    modules hold `share_missing` and `robustness`, each with its complete help page, which
//    `zeff help share_missing` prints.
use functions::share_missing
use functions::robustness

// 2. The data, with the columns the analysis derives. The shipped wages are a panel of workers
//    with missing wages, experience values and hours.
let wages = dataset(wages).add(lwage = log(wage), exper2 = exper^2)
wages.describe()

// 3. `if` decides what the script does; `case` decides values row by row.
if wages.n_rows() < 30 {
    warn("fewer than 30 rows: treat large-sample tests with care")
}
let reps = if wages.n_rows() < 500 { 5000 } else { 1000 }
print("replications for a later bootstrap:", reps)
let wages = wages.add(age_group = case {
    age < 25 => "young",
    age < 55 => "prime",
    _        => "older",
})
wages.summary([lwage, exper], by: age_group)

// 4. A loop over variables: the share of rows each variable is missing, through the project's
//    own function, called as a method.
[for v in vars(wage, exper, hours) { wages.share_missing(v) }]
let complete = wages.drop_missing([wage, exper, hours])

// 5. One model per outcome, collected into one table.
let f = lwage ~ educ + exper + exper2 + female
let fits = [for y in vars(lwage, hours, union) {
    complete.reg(y ~ educ + exper + exper2 + female)
}]
report(fits, title: "Table 1. Three outcomes, one specification")

// 6. The robustness checks of the module, clustered by the worker as its default says.
report(complete.robustness(f), title: "Table 2. Robustness of the wage equation")

// 7. Subsamples by experience, one of which has no rows: `attempt` keeps the failure as a
//    value, `report` skips it and says so, and the loop over the fits steps over it.
let cuts = [0, 10, 20, 40]
let by_experience = [for cut in cuts {
    attempt(complete.where(exper > cut).reg(f))
}]
report(by_experience, title: "Table 3. Workers with more than 0, 10, 20 and 40 years of experience")
let slopes = [for m in by_experience {
    if m.is(Failed) { continue }
    m.coef(educ)
}]
slopes

// 8. A fixed point by `iterate`: Huber's M-estimate of the location of the log wage, by
//    iteratively reweighted means from the median, with the scale set once from the median
//    absolute deviation.
/// One reweighting step: weights of one within k of the current location, k / distance beyond.
fn huber_step(s: Record, data: Frame, k: Float) -> Record {
    let d = data.add(w = k / clamp(abs(lwage - s.mu), k, Inf))
    {mu: d.mean(lwage, weights: w)}
}
/// True when a step moves the location by less than 1e-10.
fn settled(old: Record, new: Record) -> Bool {
    abs(new.mu - old.mu) < 1e-10
}
let k = 1.345 * complete.mad(lwage)
let huber = iterate(start: {mu: complete.median(lwage)},
                    step: huber_step,
                    args: {data: complete, k: k},
                    done: settled,
                    max: 100)
print("median:", complete.median(lwage))
print("mean:", complete.mean(lwage))
print("Huber location:", huber.mu)
assert(abs(huber.mu - complete.median(lwage)) < 0.05, "the Huber location lies near the median")
==== script 106
// The sample project of release 0.6.0: panels end to end, on the shipped wages and firms and
// three generated files (make_data.py). `zeff run` in this folder prints what
// expected/stdout.txt holds, and its messages are expected/stderr.txt; the script tests
// compare both byte for byte on every target, and the conformance report carries the digest
// of the file section 2 saves.

// 1. The wages, read from the engine's own data root, with each worker's firm's size and
//    founding date merged in from the firms dataset (the CSV form of the wages carries the
//    industry as text, so the firms' category of it stays out of the merge), the variables the
//    models need, and the panel declared: `lag`, `diff`, `fill_forward` and `fe:` then follow
//    the worker and the year.
let firms = dataset(firms)
let wages = import("zeff:wages.csv")
    .merge(firms.select([firm, size, founded]), on: firm, relation: many_to_one)
    .add(lwage = log(wage), exper2 = exper^2)
    .panel(unit: worker, time: year)
wages.describe()

// 2. Reshape, merge, aggregate and save: the yearly sales of each firm arrive in one row per
//    firm with a column per year, as a spreadsheet keeps them; `to_long` makes one row per
//    firm and year, the firms' industries are merged in, and the industry-year averages are
//    saved as a CSV file under `output/`.
let firm_sales = import("data/sales_wide.csv")
    .to_long("sales_", id: firm, names_to: "year", values_to: "sales", names_type: Int)
    .merge(firms, on: firm, relation: many_to_one)
    .add(log_sales = log1p(sales))
let by_industry = firm_sales.aggregate(avg_sales = mean(sales),
                                       med_sales = median(sales),
                                       firms = n(),
                                       by: [industry, year])
by_industry.sort([industry, year]).save("output/industry_year.csv")
by_industry.where(industry == "Retail")

// 3. Panel variables: the yearly growth of the log wage and the hours of the year before
//    follow each worker in year order, with `NA` where a year is missing; the hours a worker
//    did not report are carried forward from the last year that reported them; the log wage
//    is winsorized at the first and last percentile; and the deviation from the firm's mean
//    log wage is computed firm by firm with `by:`.
let wages = wages.add(wage_growth = diff(lwage),
                      lag_hours = lag(hours),
                      hours_filled = fill_forward(hours),
                      lwage_w = winsorize(lwage, at: 0.01))
let wages = wages.add(dev_firm = lwage - mean(lwage), by: firm)
wages.summary([wage_growth, lag_hours, hours_filled, lwage_w, dev_firm])

// 4. Dates: the founding date of each firm, as a year, as the firm's age, and written as text.
let firms = firms.add(founded_year = year(founded),
                      firm_age = 2026 - year(founded),
                      founded_text = format(founded, pattern: "%b %Y"))
firms.head(5)
firms.summary([firm_age], by: industry)

// 5. Regressions: robust errors, then industry and year effects absorbed, then firm and year
//    effects with the return to schooling allowed to differ by sex and the errors clustered by
//    the firm; the within and overall R² of a fixed-effects fit, and the three in one table.
let f = lwage ~ educ + exper + exper2 + female
let m1 = wages.reg(f, se: robust)
let m2 = wages.reg(f, fe: industry + year, cluster: worker)
let m3 = wages.reg(f + educ:female, fe: firm + year, cluster: firm)
m2
m3.r_squared()
report([m1, m2, m3],
       stats: [n_obs, r_squared, r_squared_within],
       title: "Table 1. The wage equation with and without fixed effects")

// 6. An event study on a staggered policy: 60 units over ten years, adopting in 2013, 2015 or
//    2017 or never; `event` makes an indicator for each year relative to adoption, the year
//    before adoption the reference, and the never-adopting units are the controls.
let policy = import("data/policy.csv").panel(unit: unit, time: year)
let es = policy.reg(y ~ event(year, adopted), fe: unit + year, cluster: unit)
es

// 7. A two-period difference in differences: 80 counties observed in 2010 and 2015, half of
//    them treated after 2010; the county and year effects absorb `treated` and `post`, and the
//    interaction is the effect of the treatment.
let counties = import("data/counties.csv").panel(unit: county, time: year)
let dd = counties.reg(emp ~ treated * post, fe: county + year, cluster: county)
dd
==== script 107
// The sample project of the plots of release 0.7.0: fifteen figures of the shipped wages,
// written under output/. The first six, of points, are each written in the three formats of a
// figure: SVG and PDF, drawn with lines, and PNG, drawn in dots at 300 to the inch. The nine
// after them draw the other marks, the scales, the panels and the shorthands, as SVG, two of
// them in all three formats. `zeff run` in this folder prints what expected/stdout.txt holds,
// and its messages are expected/stderr.txt; the script tests compare both byte for byte on
// every target, and the conformance report carries the digest of every figure, so that the
// four targets prove they write the same bytes.

// Jitter draws from the seeded stream, so the figures are the same on every run.
seed(20261112)

let wages = dataset(wages)
let w2010 = wages.where(year == 2010)

// 1. The plain scatter, at the width of one column of a journal: every worker and year, the
//    points translucent so that the crowd shows.
let schooling = wages.plot(x: educ, y: wage).points(alpha: 0.2)
schooling
schooling.export("output/fig1_wage_schooling.svg")
schooling.export("output/fig1_wage_schooling.pdf")
schooling.export("output/fig1_wage_schooling.png")

// 2. An expression on an axis, and schooling moved a little sideways so that the columns of
//    whole years open up; at the full width of a page.
let logged = wages.plot(x: educ, y: log(wage)).points(alpha: 0.15, jitter: 0.4)
logged.export("output/fig2_log_wage.svg", size: two_column)
logged.export("output/fig2_log_wage.pdf", size: two_column)
logged.export("output/fig2_log_wage.png", size: two_column)

// 3. A category shown by colour, with its legend.
let by_union = wages.plot(x: exper, y: wage, color: union).points(alpha: 0.3)
by_union.export("output/fig3_union.svg", size: one_column)
by_union.export("output/fig3_union.pdf", size: one_column)
by_union.export("output/fig3_union.png", size: one_column)

// 4. A number shown on a ramp of colours.
let by_hours = w2010.plot(x: educ, y: wage, color: hours).points(size: 6, jitter: 0.5)
by_hours.export("output/fig4_hours.svg", size: [120, 80])
by_hours.export("output/fig4_hours.pdf", size: [120, 80])
by_hours.export("output/fig4_hours.png", size: [120, 80])

// 5. Size by area, and sex by colour and by shape at once: one legend for sex, one for hours.
//    The notes on the rows that cannot be drawn are written under this figure.
let sized = w2010
    .plot(x: exper, y: wage, size: hours, color: female, shape: female)
    .points(alpha: 0.5)
sized
sized.export("output/fig5_size_shape.svg", size: two_column, notes: true)
sized.export("output/fig5_size_shape.pdf", size: two_column, notes: true)
sized.export("output/fig5_size_shape.png", size: two_column, notes: true)

// 6. Twelve industries by shape and colour on a slide: there are eight of each, so they repeat
//    from the ninth, and a note says so.
let by_industry = w2010.plot(x: age, y: hours, color: industry, shape: industry).points(size: 7)
by_industry.export("output/fig6_industry.svg", size: slide)
by_industry.export("output/fig6_industry.pdf", size: slide)
by_industry.export("output/fig6_industry.png", size: slide)

// 7. Lines and a band: the mean wage of each year with its 95% interval, by sex, the legend
//    under the panel. In the three formats.
let yearly = wages
    .drop_missing([wage])
    .aggregate(mean = mean(wage), se = sd(wage) / sqrt(n()), by: [year, female])
    .add(low = mean - 1.96 * se, high = mean + 1.96 * se)
let trend = yearly
    .plot(x: year, y: mean, color: female)
    .ribbon(low: low, high: high, fill: female)
    .lines()
    .points(size: 3)
    .labels(title: "Mean hourly wage by year", x: "Year", y: "Mean hourly wage")
    .legend(position: bottom)
trend
trend.export("output/fig7_trend.svg")
trend.export("output/fig7_trend.pdf")
trend.export("output/fig7_trend.png")

// 8. Bars with error bars, turned on their side: the mean wage of each industry.
let industry_means = wages
    .drop_missing([wage])
    .aggregate(mean = mean(wage), se = sd(wage) / sqrt(n()), by: industry)
    .add(low = mean - 1.96 * se, high = mean + 1.96 * se)
let industries = industry_means
    .plot(x: industry, y: mean)
    .bars(fill: "steelblue")
    .errorbars(low: low, high: high)
    .coord(type: flip)
    .labels(x: "", y: "Mean hourly wage")
industries
industries.export("output/fig8_industries.svg", size: two_column)

// 9. A histogram on the density scale with the kernel density over it, each value marked at
//    the foot and the mean by a line; in the plain theme.
let shape = w2010
    .plot(x: log(wage))
    .histogram(bins: 30, scale: density)
    .density()
    .rug(alpha: 0.2)
    .vline(at: 3.02)
    .theme(name: minimal)
shape.export("output/fig9_shape.svg")

// 10. Box plots on a logarithmic axis, one for each industry, the industries up the side.
let boxes = w2010
    .plot(x: industry, y: wage)
    .boxplot()
    .scale_y(type: log)
    .coord(type: flip)
    .labels(x: "")
boxes.export("output/fig10_boxes.svg", size: two_column)

// 11. Areas stacked: the workers of each year by union membership, in colours given by hand,
//     with a step line for their total, a line across at two thousand and a word beside it.
let counts = wages.aggregate(workers = n(), by: [year, union])
let totals = wages.aggregate(workers = n(), by: year)
let stacked = counts
    .plot(x: year, y: workers, fill: union)
    .area(position: stack)
    .step(data: totals, x: year, y: workers)
    .hline(at: 2000)
    .annotate("two thousand", x: 2019.8, y: 2080)
    .scale(fill: ["#bdbdbd", "#0072b2"])
    .legend(position: top)
stacked
stacked.export("output/fig11_stacked.svg")

// 12. A heat map with its numbers: the mean log wage by schooling and experience in bands, on
//     the viridis ramp, with a title and a caption. In the three formats.
let cells = wages
    .drop_missing([wage, exper])
    .add(
        lwage = log(wage),
        school = bin(educ,
                     breaks: [-Inf, 11, 12, 15, 16, Inf],
                     labels: ["under 12", "12", "13 to 15", "16", "over 16"]),
        years = bin(exper,
                    breaks: [-Inf, 5, 10, 15, 20, Inf],
                    labels: ["0 to 5", "6 to 10", "11 to 15", "16 to 20", "over 20"]),
    )
    .aggregate(lwage = mean(lwage), by: [school, years])
    .add(shown = format(lwage, digits: 2))
    .label(lwage, "Mean log wage")
let grid = cells
    .plot(x: years, y: school, fill: lwage)
    .tile()
    .text(label: shown, color: "white")
    .scale(fill: viridis)
    .labels(x: "Years of experience",
            y: "Years of schooling",
            caption: "shipped wages, 2010 to 2021")
grid.export("output/fig12_grid.svg")
grid.export("output/fig12_grid.pdf")
grid.export("output/fig12_grid.png")

// 13. Small multiples: wage on experience in four industries, each panel with its own scale
//     up the side and the breaks along the foot given.
let panels = w2010
    .where(is_in(industry, ["Construction", "Education", "Finance", "Retail"]))
    .plot(x: exper, y: wage, color: female)
    .points(alpha: 0.6, size: 3)
    .facet(by: industry, scales: free_y)
    .scale_x(breaks: [0, 10, 20])
    .legend(position: bottom)
panels
panels.export("output/fig13_panels.svg", size: two_column)

// 14. A shorthand: one call for a scatter with its fitted line, by union membership.
w2010.scatter(educ, log(wage), fit: linear, color: union).export("output/fig14_scatter.svg")

// 15. A regression's coefficients with their intervals, the other figure a fit draws of itself.
let fit = wages.reg(log(wage) ~ educ + exper + female + union, cluster: worker)
fit.coef_plot().export("output/fig15_coefficients.svg")
==== script 108
// The sample project of release 0.7.0 for its tests: the questions a first look at the shipped
// wages asks, each answered by the test that fits it. `zeff run` in this folder prints what
// expected/stdout.txt holds, and its messages are expected/stderr.txt; the conformance suite
// compares both byte for byte on every target.

// 1. The data: the shipped wages with the log wage added and the codes of sex labelled.
let wages = dataset(wages)
    .add(lwage = log(wage))
    .label(female, [0 => "male", 1 => "female"])

// 2. Tables: how many rows in each industry, and union membership by sex in row percentages.
wages.tabulate(industry)
wages.tabulate([female, union], percent: row)

// 3. One mean and two: is the mean of schooling 13 years, and do men and women differ in the
//    log wage? Welch's test unless the variances are said to be equal; the rank-sum test asks
//    the second question without the normal distribution.
wages.t_test(educ, mu: 13)
let by_sex = wages.t_test(lwage, group: female)
by_sex
print("difference in log wage, Hedges' g:", by_sex.effect_size())
wages.wilcoxon_test(lwage, group: female)

// 4. Proportions and counts: the share of union members against one in five, the same share
//    by sex, and the two-way table tested by chi-squared and by Fisher's exact test.
wages.proportion_test(union, p: 0.2)
wages.proportion_test(union, group: female)
wages.chi2_test(union, female)
wages.where(year == 2010 && industry == "Mining").fisher_test(union, female)

// 5. The shape of a distribution: Shapiro–Wilk on the log wages of one year and one industry,
//    and Kolmogorov–Smirnov against the normal with the mean and the standard deviation
//    estimated, which is Lilliefors' test.
let retail = wages.where(year == 2010 && industry == "Retail")
retail.shapiro_test(lwage)
retail.ks_test(lwage, dist.normal(), estimated: true)

// 6. Several groups: the log wage across industries by Welch's analysis of variance, with
//    omega squared, and by the Kruskal–Wallis test; then the pairs of four industries, by
//    Tukey's method on the pooled variance at 99%, and by Holm's on Welch's t-tests.
wages.anova(lwage, group: industry, effect: omega)
wages.kruskal_test(lwage, group: industry)
let four = wages.where(is_in(industry, ["Construction", "Education", "Finance", "Retail"]))
let pooled = four.anova(lwage, group: industry, equal_var: true)
let pairs = pooled.posthoc(level: 0.99)
pairs
print("Finance against Education, p:", pairs.p_values("Finance - Education"))
four.anova(lwage, group: industry).posthoc(method: holm)

// 7. Two factors and a covariate: the table of a formula, type 2, with the partial omega
//    squared computed from F; one term read by its name; and the marginal means of sex compared.
let two_way = wages.anova(lwage ~ industry * category(female) + educ, effect: omega_f)
two_way
print("interaction, F:",
      two_way.statistic("industry:female"),
      "p:",
      two_way.p_values("industry:female"))
print("schooling, partial omega squared from F:", two_way.effect_size(educ))
two_way.posthoc(term: female, method: none)

// 8. Many tests at once: the same two-group test on four variables, their p-values adjusted
//    together by Holm's method and by Benjamini and Hochberg's.
let outcomes = vars(lwage, hours, educ, exper)
let p = [for v in outcomes { wages.t_test(v, group: female).p_values() }]
p
p_adjust(p)
p_adjust(p, method: bh)

// 9. Association: the correlations of four variables with their p-values, by Pearson and by
//    Spearman.
wages.correlation([lwage, educ, exper, hours], p_values: true)
wages.correlation([lwage, educ, exper, hours], method: spearman)
