let d = import("data/PiDigits.csv").add(t = row_number(), one = 1)
print(to(d.mean(y), Str))
print(to(d.sd(y), Str))
let v = d
    .panel(unit: one, time: t)
    .add(c = (y - mean(y)) * (coalesce(lag(y), mean(y)) - mean(y)), q = (y - mean(y))^2)
print(to(v.sum(c) / v.sum(q), Str))
