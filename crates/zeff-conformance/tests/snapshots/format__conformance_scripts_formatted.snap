              age = [3, 5, 4, 6, 5, 7, 6, 4, 5, 3, 6, 4, 7, 5, 4, 6])
    .add(dose = category(dose, levels: ["low", "mid", "high"]), diet = category(diet))
let m = f.anova(gain ~ dose * diet + age)
m.posthoc(term: dose)
m.posthoc(term: diet, method: scheffe)
m.posthoc(term: "dose:diet", method: holm)
f.anova(gain ~ dose * log(age)).posthoc(method: sidak)
f
    .where(!(dose == "high" && diet == "a"))
    .anova(gain ~ dose * diet)
    .posthoc(term: "dose:diet", method: bonferroni)
