let wages = dataset(wages)
let lr1 = wages.glm(union ~ educ + exper + female + industry, family: binomial)
let lr0 = wages.glm(union ~ educ + exper, family: binomial)
lr1.fit_measures()
lr1.coef()
lr1.ci(female)
lr1.compare(lr0)
lr1.test(educ == exper, female == 0)
lr1.derive(ratio = educ / exper, odds = exp(female))
lr1.predict(newdata: wages.head(3))
lr1.predict(newdata: wages.head(3), type: link)
lr1.design().head(3)
wages
    .add(response = lr0.residuals(),
         pearson = lr0.residuals(type: pearson),
         deviance = lr0.residuals(type: deviance),
         working = lr0.residuals(type: working),
         fitted = lr0.fitted())
    .summary([response, pearson, deviance, working, fitted])
report([lr0, lr1, wages.reg(union ~ educ + exper)], stats: [n_obs, r_squared, aic, bic])
