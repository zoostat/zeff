let w = dataset(wages)
// zeff: allow(W0204) a worker in the first year has no experience
let a = w.add(l = log(exper))
a.summary([l])
let b = w.add(l = log(exper))                         // zeff: allow(W0204) the same, at the end of the line
b.n_rows()
for i in [1, 2] {
    // zeff: allow(W0204) in each pass
    print(w.add(l = log(exper) * i).n_rows())
}
/// The rows of a frame after its logarithm is taken.
fn logged(f: Frame) -> Int {
    // zeff: allow(W0204) inside a function
    f.add(l = log(exper)).n_rows()
}
logged(w)
print("allowed so far")
let c = w.add(l = log(exper))
c.n_rows()
let d = w.add(l = log(exper - 1))
