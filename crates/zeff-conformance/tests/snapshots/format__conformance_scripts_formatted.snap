/// Applies a function to a float.
fn applyf(f: Fn(Float) -> Float, x: Float) -> Float { f(x) }
/// Halves.
fn half(x: Float) -> Float { x / 2 }
[applyf(abs, -3), applyf(sqrt, 16), applyf(half, 9)]
==== script 14
let w = dataset(wages)
/// Share of rows where a variable is missing.
fn share_missing(data: Frame, var: Var) -> Float {
    data.where(is_missing(var)).n_rows() / data.n_rows()
}
/// Three standard robustness checks for one specification.
fn robustness(data: Frame, f: Formula, cluster: Var = worker) -> List<RegFit> {
    [data.reg(f, se: robust),
     data.reg(f, cluster: cluster),
     data.where(year >= 2015).reg(f, se: robust)]
}
/// Winsorised share.
fn band(x: Float, top: Float = x * 2) -> Str {
    if x > top { return "above" }
    "within"
}
w.share_missing(wage)
report(w.robustness(log(wage) ~ educ + exper))
[band(1), band(3, top: 2)]
