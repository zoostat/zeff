                      5.6,
                      4.9,
                      5.4,
                      5.8,
                      4.5,
                      4.0,
                      4.8,
                      4.3,
                      5.0,
                      4.7],
              dose = ["low",
                      "low",
                      "low",
                      "low",
                      "mid",
                      "mid",
                      "mid",
                      "mid",
                      "mid",
                      "high",
                      "high",
                      "high",
                      "high",
                      "high",
                      "low",
                      "mid"],
              diet = ["a",
                      "b",
                      "a",
                      "b",
                      "a",
                      "b",
                      "a",
                      "b",
                      "a",
                      "b",
                      "a",
                      "b",
