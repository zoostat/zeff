    training -> productivity
    age -> [training, tenure]
    region -> [tenure, productivity]
    tenure -> offer
}
staff.reg(productivity ~ training + tenure).check(mg, exposure: training)
staff.reg(productivity ~ training + offer).check(mg, exposure: training)
staff.reg(productivity ~ training + tenure + region).check(mg, exposure: training)
