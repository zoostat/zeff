print(to(ssr, Str))
print(to(ssr / 5, Str))
print(to((ssr / 5) / (rss / 15), Str))
print(to(rss, Str))
print(to(rss / 15, Str))
==== script 235
let d = import("data/Wampler5.csv")
let m = d.reg(y ~ x + x^2 + x^3 + x^4 + x^5)
print(to(m.coef(`(intercept)`), Str))
print(to(m.std_errors(`(intercept)`), Str))
print(to(m.coef(`x`), Str))
print(to(m.std_errors(`x`), Str))
print(to(m.coef(`x^2`), Str))
print(to(m.std_errors(`x^2`), Str))
print(to(m.coef(`x^3`), Str))
print(to(m.std_errors(`x^3`), Str))
print(to(m.coef(`x^4`), Str))
print(to(m.std_errors(`x^4`), Str))
print(to(m.coef(`x^5`), Str))
print(to(m.std_errors(`x^5`), Str))
let s = d.add(e = m.residuals(), f = m.fitted()).add(e2 = e^2, f2 = (f - mean(y))^2)
let rss = s.sum(e2)
let ssr = s.sum(f2)
print(to(sqrt(rss / 15), Str))
print(to(m.fit_measures().r_squared, Str))
print(to(ssr, Str))
print(to(ssr / 5, Str))
print(to((ssr / 5) / (rss / 15), Str))
print(to(rss, Str))
print(to(rss / 15, Str))
