---- regressions/test_result_as_typst/output/two_groups.typ
// a Zeff export: place it in a document with `#include`
// t_test · Welch two-sample · x by g
#layout(size => {
  let body = table(
    columns: 4,
    align: (left, right, right, right,),
    stroke: none,
    table.hline(stroke: 0.8pt),
    table.header("group", "N", "mean", "sd"),
    table.hline(stroke: 0.5pt),
    "a", "3", "2.000", "1.000",
    "b", "3", "5.333", "1.528",
    table.hline(stroke: 0.8pt),
  )
  let notes = (
    text(size: 0.85em, grid(columns: 2, column-gutter: 2em, row-gutter: 0.65em, "H0: the population means of x are equal in a and b", "μ(a) − μ(b) = 0", "H1: the population means of x differ between a and b", "μ(a) − μ(b) ≠ 0")),
    text(size: 0.85em, "difference (a − b) = -3.333   95% CI [-6.454, -0.212]"),
    text(size: 0.85em, "t = -3.16   df = 3.4   p = 0.042"),
    text(size: 0.85em, "Hedges' g = -2.07   95% CI [-3.80, -0.33]"),
    text(size: 0.85em, "decision at α = 0.05: reject H0 (p = 0.042)"),
  )
  let widest = calc.max(measure(body).width, ..notes.map(note => measure(note).width + 10pt))
  block(width: calc.min(size.width, widest), {
    set align(left)
    set block(spacing: 0.65em)
    body
    for note in notes {
      block(inset: (x: 5pt), note)
    }
  })
})
