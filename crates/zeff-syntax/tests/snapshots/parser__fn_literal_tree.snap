source: crates/zeff-syntax/tests/parser.rs
expression: "tree(\"let p = map(seq(1, n - 1), fn(i) i / n)\\nlet s = reduce(xs, fn(acc: Float, x) acc + x, 0.0)\\nlet k = xs.filter(fn(x) if x > 1 { true } else { false })\\nlet e = map([], fn() 1)\\n\")"
---
(let p (map (seq 1 (- n 1)) (fn (i) (/ i n))))
(let s (reduce xs (fn (acc: Float x) (+ acc x)) 0.0))
(let k (method filter xs (fn (x) (if (> x 1) (block true) else (block false)))))
(let e (map [] (fn () 1)))
