let a = 1                                             // why one
let b = some_function(with_arguments, of_some_length, and_more)  // a comment at the end

// before c, wrongly indented
let c = f(x,                                          // the first
          y,                                          // the second
          // before z
          z)
let d = wages
    // before the where
    .where(year > 2010)                               // after the where
    .n_rows()
// zeff: allow(W0201) the sum skips rows by design
let e = d.sum(x)
let f = d.sum(y)                                      // zeff: allow(W0201) the same
for i in 1..3 {                                       // on the brace
    // inside
    print(i)


    print(i + 1)
    // at the end of the block
}
let g = [1,                                           // one
         2]
for j in 1..3 {
    print(j)                                          // of the statement, not of the brace
