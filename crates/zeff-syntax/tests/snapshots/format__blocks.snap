/// Three checks.
///
///   an indented line of the page
/// data: The frame.
/// > robustness(d)
fn robustness(data: Frame, f: Formula, cluster: Var = firm) -> List<RegFit> {
    [data.reg(f, se: robust),
     data.reg(f, cluster: cluster)]
}

fn with_many_parameters(first_parameter: Column<Float>,
                        second_parameter: Fn(Float, ..) -> Float,
                        third: {a: Int, b: Str},
                        fourth: classical | robust = classical,
                        fifth: Float? = NA) -> Nothing {
    if first { return }
    for x in xs {
        if x > 1 {
            continue
        } else if x < 0 { break } else {
            print(x)
        }
    }
}
let m = model {
    engagement =~ eng1 + eng2
    support    =~ sup1 + sup2 + sup3
    engagement ~ support as a
    turnover   ~ engagement as b + support as c
    indirect   := a * b
    eng1       ~~ eng2
}
let g = dag {
    ability -> training -> productivity
    [age, region] -> training
    x <-> y -- z
    latent ability, u
    selected s
}
let h = dag { a -> b }
let k = case {
    age < 25                => "young",
    age < 55 && tenure > 10 => {
        let y = 2
        y
    },
    _                       => "older",
}
let empty = if a {} else {}
