---
source: crates/zeff-syntax/tests/parser.rs
expression: "sexp::script(&parsed.script)"
---
(use functions::robustness)
(seed 20261015)
(let wages (method panel (method recode (method label (method add (method where (import "data/wages.csv" na_values:[(neg 99) (neg 98)] types:(record hours:Str) names:snake) (&& (>= year 2010) (>= age 18))) lwage=(log gross_wage) exper2=(^ exper 2) hours=(to hours Float) industry=(category industry) edu=(category edu levels:["school" "college" "postgrad"] ordered:true) age_group=(case ((< age 25) => "young") ((< age 55) => "prime") (_ => "older"))) female (mapping (0 => "male") (1 => "female"))) industry (mapping ("Mining" => "Other") ("Utilities" => "Other"))) unit:worker time:year))
(assert (> (method n_rows wages) 1000) "too few rows left after cleaning")
(let lfs (method select (import "lfs:lfs_2024.parquet") [region wage sector]))
(method describe wages)
(method summary wages [lwage educ exper hours] by:female)
(method tabulate wages [industry age_group] percent:row)
(method correlation wages [lwage educ exper hours] method:spearman p_values:true)
(method export (method histogram wages lwage bins:40 by:female) "output/fig_lwage.pdf" size:one_column)
(method export (method scatter wages educ lwage fit:linear color:female) "output/fig_educ.png")
(let firms (import "data/firms.csv"))
(let firm_sales (method add (method merge (method to_long (import "data/sales_wide.csv") "sales_" id:firm_id names_to:"year" values_to:"sales") firms on:firm_id relation:many_to_one) log_sales=(log1p sales)))
(let by_industry (method aggregate firm_sales avg_sales=(mean sales) med_sales=(median sales) firms=(n) by:[industry year]))
(method save (method sort by_industry [industry year]) "output/industry_year.csv")
(let wages (method add wages wage_growth=(diff lwage) lag_hours=(lag hours) lwage_w=(winsorize lwage at:0.01)))
(let wages (method add wages dev_firm=(- lwage (mean lwage)) by:firm))
(let f (~ lwage (+ (+ (+ educ exper) exper2) female)))
(let m1 (method reg wages f se:robust))
(let m2 (method reg wages f fe:(+ industry year) cluster:worker))
(let m3 (method reg wages (+ f (: educ female)) fe:(+ worker year) cluster:worker))
(let m4 (method reg wages f fe:(: industry year) cluster:firm weights:sample_wt))
m2
(method test m3 (== educ exper))
(method vif m1)
(method influence m1)
(method export (report [m1 m2 m3 m4] stats:[n_obs r_squared] labels:(record educ:"Years of schooling" exper:"Experience")) "output/table1.docx")
(method export (method coef_plot m3) "output/fig_coef.pdf" size:one_column)
(let fits (list-(for y (vars lwage hours wage_growth) (block (method reg wages (~ y (+ (+ educ exper) exper2)) fe:(+ industry year) cluster:worker)))))
(method export (report fits) "output/table2.docx")
(method export (report (method robustness wages f cluster:worker)) "output/table3.docx")
(let card (import "data/card.csv"))
(let iv (method ivreg card (~ lwage (+ (+ (+ exper (^ exper 2)) black) educ)) fe:region instruments:(~ educ nearc4) se:robust first:true))
(method first_stage iv)
(method export (report [(method reg card (~ lwage (+ (+ (+ exper (^ exper 2)) black) educ)) fe:region se:robust) iv]) "output/table_iv.tex")
(let counties (method panel (import "data/counties.csv") unit:county time:year))
(let dd (method reg counties (~ emp (* treated post)) fe:(+ county year) cluster:county))
dd
(method t_test wages lwage group:female)
(method t_test wages lwage mu:3)
(method wilcoxon_test wages hours group:female)
(method anova wages lwage group:industry)
(method chi2_test wages industry female)
(method proportion_test wages union group:female)
(let p (list-(for v (vars lwage hours educ) (block (method p_values (method t_test wages v group:female))))))
(p_adjust p method:holm)
(let lg (method logistic wages (~ union (+ (+ (+ educ exper) female) industry)) cluster:worker))
(let pr (method probit wages (~ union (+ (+ (+ educ exper) female) industry)) cluster:worker))
(method export (report [lg pr]) "output/table_union.docx")
(let lr1 (method logistic wages (~ union (+ (+ (+ educ exper) female) industry))))
(let lr0 (method logistic wages (~ union (+ educ exper))))
(method compare lr1 lr0)
(method test lg (== female 0))
(let size 200)
(let sims (list-(for s (.. 1 500) (block (let d (method add (frame x=(method draw (method normal dist) n:size seed:s) u=(method draw (method uniform dist) n:size seed:(+ s 10000))) y=(case ((> (inv_logit (* 0.5 x)) u) => 1) (_ => 0)))) (attempt (method logistic d (~ y x)))))))
(len sims)
(let slopes (list-(for m sims (block (if (method is m Failed) (block (continue))) (method coef m x)))))
(method summary (frame b=slopes) [b])
(let engage (import "data/engagement.csv"))
(method reliability engage [(.. eng1 eng6)])
(let engage (method add engage engagement=(row_mean [(.. eng1 eng6)] min_valid:5)))
(let g (dag (edges ability -> training -> productivity) (edges ability -> productivity) (edges training -> tenure -> productivity) (edges [age region] -> training) (latent ability)))
(method adjustment_sets g exposure:training outcome:productivity)
(method implied_independencies g)
(method export (method plot g) "output/fig_dag.pdf" size:one_column)
(let staff (import "data/staff.csv"))
(let mt (method reg staff (~ productivity (+ (+ (+ training tenure) age) region)) cluster:firm))
(method check mt g exposure:training)
(let wages (method add wages industry=(category industry contrast:sum)))
(let m5 (method reg wages (~ lwage (+ (+ (+ educ exper) exper2) industry)) se:robust))
(method derive m5 peak_exper=(/ (neg exper) (paren (* 2 exper2))) educ_vs_exper=(/ educ exper))
(method scatter wages educ lwage)
(method export (method theme (method labels (method scale_y (method facet (method points (plot wages x:educ y:lwage color:female) alpha:0.3) by:industry scales:free_y) log) title:"Schooling and wages by industry" y:"log wage") journal) "output/fig_wages.pdf" size:two_column)
(let means (method aggregate wages mean_lwage=(mean lwage) se=(/ (sd lwage) (sqrt (n))) by:[industry female]))
(method legend (method errorbars (method bars (plot means x:industry y:mean_lwage color:female) position:dodge) low:(- mean_lwage (* 1.96 se)) high:(+ mean_lwage (* 1.96 se))) top)
